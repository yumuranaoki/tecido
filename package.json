{
  "name": "tecido",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tecido": "./src/cli/index.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:integration": "node --import ./tests/support/register.mjs --test ./tests/integration/*.test.ts",
    "test:e2e": "node --import ./tests/support/register.mjs --test ./tests/e2e/**/*.test.ts"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.6.3",
    "ai": "^7.0.126",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "remeda": "^2.50.0",
    "ts-pattern": "^5.9.0",
    "typescript": "^7.0.2",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ai": "^7.0.126"
  },
  "lint-staged": {
    "**/*.ts": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "**/*.{json,jsonc,md,yaml,yml}": "oxfmt --write"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
